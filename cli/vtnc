#!/usr/bin/env node
// The CLI (decision 4b.2/4b.3): vtnc <namespace> <name> <verb> <args...>,
// or vtnc <namespace> <verb> <args...> for verbs that don't target one name
// (list). `set` writes config.json directly; `call`/`get`/`list` talk to
// the running shell over IPC (decision 4b.4/4b.5).

import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";
import { execFileSync } from "node:child_process";
import { readConfig, writeConfig } from "./lib/store.js";
import { ipcCall } from "./lib/ipc.js";
import {
    findIsland, findPage, validateIslandSet, parseIslandSetValue,
    validatePageSet, parsePageSetValue, defaultPage,
    validateAutohideGlobalSet, parseAutohideGlobalValue, defaultAutohide,
    validateHyprlandSet, parseHyprlandSetValue, defaultHyprland,
} from "../core/config-shape.mjs";
import { syncHyprlandFiles } from "./lib/hyprland-write.js";
import { loadCatalog } from "./lib/plugins.js";

const VERBS = new Set(["set", "call", "get", "list", "end", "generate", "create", "delete"]);
// The full namespace list from decision 4b.3 — widget/monitor/preset/theme
// are listed even though they have no verbs yet (also decision 4b.3).
// `autohide` (0.505) is one of the "futuros" 4b.3 already names the list
// as open to — it's global, not per-island, so it has no target name, the
// same grammar `page list`/`service list` already use. `hyprland` (0.507)
// is the same shape as `autohide`: global, no target name.
// `plugin` (0.512) e o namespace da varredura: `list` mostra o que a shell
// achou, com versao, nivel de API e por que um plugin nao carregou. Os
// verbos que um PLUGIN declara para si proprio sao outro passo (4.8) -
// este aqui e sobre os plugins, nao de um plugin.
const NAMESPACES = new Set(["island", "page", "widget", "service", "monitor", "preset", "theme", "autohide", "hyprland", "plugin"]);
const NAMESPACES_WITH_VERBS = new Set(["island", "page", "service", "autohide", "hyprland", "plugin"]);

// The shell's own source folder — one level up from cli/ — doubles as its
// quickshell config name (vtnc-dev while developing, vtnc once installed),
// so the CLI never has to be told which one it's talking to.
const shellRoot = dirname(dirname(fileURLToPath(import.meta.url)));

function usage() {
    console.log(`usage: vtnc <namespace> <name> <verb> [args...]
       vtnc <namespace> <verb> [args...]   (for verbs with no target name, e.g. list)
       vtnc                                 start the shell
       vtnc help                            this message

namespaces: island, page, widget, service, monitor, preset, theme, autohide, hyprland
  (widget, monitor, preset and theme have no verbs yet)
verbs: set, call, get, list, end, generate

0.506: the trigger lives on the page, not the island (decision 1b.5) — call
a page onto an island with "page <name> call <island>", never the other
way around. Ending a call is per-island, not per-page — it just pops
whatever's on top ("island <name> end"); it lands back on the idle page by
itself once the stack (up to 5 deep) empties.

island set keys: page, layer, anchor, offset, size, gap, autohide, autohideMode
  (anchor/offset/size take one JSON object argument; gap is one whole number
   of cells — never four sides, it only reserves on the anchored edge;
   autohide is true/false; autohideMode is one of always/window/fullscreen.
   autohide/autohideMode left unset on an island fall back to the global
   autohide values below.)

autohide set keys: enabled, mode, distance
  (global, not per-island: enabled/mode are the fallback for islands that
   don't set their own; distance (cells) is global-only, it also decides
   which of the two hide animations an island gets — see island/README.md)

page set keys: grid, widgets
  (0.508: os dois sao um argumento JSON so. "grid" e {"cols":N,"rows":N};
   "widgets" substitui a lista inteira, cada entrada
   {"module":"vtnc.clock","cell":{"x":0,"y":0,"w":6,"h":2}} com "face"
   opcional. A page e dona das instancias (decisao 6.1): mexer numa page
   muda todas as islands que a usam, ao vivo. "create" e "delete" criam e
   apagam a page em si; apagar uma page em uso deixa as islands que a
   vestiam no estado empty (decisao 14.3), nao as derruba.)

hyprland set keys: enabled, keybinds
  (0.507: "enabled" is consent (decision 10.3b) — nothing is written under
   ~/.config/hypr/vtnc until this is true. "keybinds" replaces the whole
   array in one JSON argument, each entry shaped like
   {"key":"SUPER + Q","commands":["..."],"enabled":true,"description":""}.
   "generate" writes the Lua file and runs hyprctl reload — the running
   shell calls this on its own whenever the config changes and consent is
   given; calling it by hand is harmless and always available.)

examples:
  vtnc page launcher call bar       momentary: stacks launcher onto bar
  vtnc island bar end               unstacks one level (back to idle if empty)
  vtnc island bar set page dashboard   permanent: writes config.json
  vtnc island bar set anchor '{"top":true,"left":true}'
  vtnc island bar set offset '{"x":2,"y":0}'
  vtnc island bar set size '{"w":20,"h":6}'
  vtnc island bar set gap 2
  vtnc island bar set autohide true
  vtnc island bar set autohideMode window
  vtnc island bar get               current state, as JSON
  vtnc island list                  all islands, as JSON
  vtnc page list                    all pages, as JSON
  vtnc service list                 which services are on and who's holding them
  vtnc service clock get            one service's state, as JSON
  vtnc autohide set distance 3      global trigger distance, in cells
  vtnc autohide list                current global autohide config, as JSON
  vtnc hyprland set enabled true    consent: the shell starts writing/reloading
  vtnc hyprland set keybinds '[{"key":"SUPER + Return","commands":["kitty"],"enabled":true}]'
  vtnc hyprland list                current hyprland config, as JSON
  vtnc page dashboard create        a new, empty page
  vtnc page dashboard set grid '{"cols":12,"rows":4}'
  vtnc page dashboard set widgets '[{"module":"vtnc.clock","cell":{"x":0,"y":0,"w":6,"h":2}}]'
  vtnc page dashboard delete        islands wearing it fall back to empty`);
}

function startShell() {
    execFileSync("qs", ["-p", shellRoot], { stdio: "inherit" });
}

function cmdSetIsland(name, args) {
    const [key, rawValue] = args;
    if (!key || rawValue === undefined) {
        console.error("vtnc: set needs a key and a value, e.g. set page dashboard");
        process.exit(1);
    }

    const config = readConfig();
    const island = findIsland(config, name);
    if (!island) {
        console.error(`vtnc: no such island: ${name}`);
        process.exit(1);
    }

    const value = parseIslandSetValue(key, rawValue);
    const error = validateIslandSet(key, value, config);
    if (error) {
        // config.json is untouched: we haven't written anything yet.
        console.error(`vtnc: ${error}`);
        process.exit(1);
    }

    island[key] = value;
    writeConfig(config);
    console.log(JSON.stringify(island));
}

// `vtnc autohide set <key> <value>` (0.505): global, no island name — the
// same `vtnc <namespace> <verb> <args>` grammar `page list` already uses.
// distance is global-only by decision 12.4; enabled/mode are the fallback
// an island falls back to when it doesn't set its own autohide/
// autohideMode (decision 11.2c).
function cmdSetAutohide(args) {
    const [key, rawValue] = args;
    if (!key || rawValue === undefined) {
        console.error("vtnc: set needs a key and a value, e.g. set distance 2");
        process.exit(1);
    }

    const config = readConfig();
    const value = parseAutohideGlobalValue(key, rawValue);
    const error = validateAutohideGlobalSet(key, value);
    if (error) {
        console.error(`vtnc: ${error}`);
        process.exit(1);
    }

    config.autohide = { ...defaultAutohide(), ...config.autohide, [key]: value };
    writeConfig(config);
    console.log(JSON.stringify(config.autohide));
}

// `vtnc hyprland set <key> <value>` (0.507): same nameless grammar as
// autohide. This only ever writes config.json (decision 4b.4) — it never
// touches ~/.config/hypr/vtnc itself and never calls hyprctl; that's
// `generate`'s job, run by the shell reacting to this write, not by `set`
// directly.
function cmdSetHyprland(args) {
    const [key, rawValue] = args;
    if (!key || rawValue === undefined) {
        console.error("vtnc: set needs a key and a value, e.g. set enabled true");
        process.exit(1);
    }

    const config = readConfig();
    const value = parseHyprlandSetValue(key, rawValue);
    const error = validateHyprlandSet(key, value);
    if (error) {
        console.error(`vtnc: ${error}`);
        process.exit(1);
    }

    config.hyprland = { ...defaultHyprland(), ...config.hyprland, [key]: value };
    writeConfig(config);
    console.log(JSON.stringify(config.hyprland));
}

// `vtnc hyprland generate`: writes ~/.config/hypr/vtnc/keybinds.lua from
// whatever's in config.json right now and runs `hyprctl reload` (decision
// 7.2). core/HyprlandSync.qml spawns exactly this from the running shell
// whenever config.hyprland changes — "a shell roda hyprctl reload sozinha"
// is this call, made by the shell. Calling it by hand does the same thing
// and is harmless (it's a no-op without consent — see syncHyprlandFiles).
function cmdGenerateHyprland() {
    const config = readConfig();
    console.log(JSON.stringify(syncHyprlandFiles(config)));
}

// `vtnc page <nome> set <chave> <valor>` (0.508). Escreve o config.json
// direto como todo `set` (decisao 4b.4); quem percebe a mudanca e redesenha
// e a shell, por `core/Config.qml`.
function cmdSetPage(name, args) {
    const [key, rawValue] = args;
    if (!key || rawValue === undefined) {
        console.error("vtnc: set needs a key and a value, e.g. set grid '{\"cols\":10,\"rows\":4}'");
        process.exit(1);
    }

    const config = readConfig();
    const page = findPage(config, name);
    if (!page) {
        console.error(`vtnc: no such page: ${name}`);
        process.exit(1);
    }

    const value = parsePageSetValue(key, rawValue);
    const error = validatePageSet(key, value, loadCatalog());
    if (error) {
        console.error(`vtnc: ${error}`);
        process.exit(1);
    }

    page[key] = value;
    writeConfig(config);
    console.log(JSON.stringify(page));
}

// `vtnc page <nome> create`: uma page vazia, com a grade padrao.
function cmdCreatePage(name) {
    if (!name) {
        console.error("vtnc: create needs a page name, e.g. vtnc page dashboard create");
        process.exit(1);
    }
    const config = readConfig();
    config.pages = config.pages ?? {};
    if (config.pages[name]) {
        console.error(`vtnc: page already exists: ${name}`);
        process.exit(1);
    }
    config.pages[name] = defaultPage();
    writeConfig(config);
    console.log(JSON.stringify(config.pages[name]));
}

// `vtnc page <nome> delete`: apaga a page. As islands que a vestiam NAO sao
// mexidas aqui de proposito - elas continuam apontando para um nome que nao
// existe mais, e e a shell que desenha o estado empty nesse caso (decisao
// 14.3). Mexer nas islands aqui faria a CLI reescrever configuracao que o
// usuario nao pediu para mudar, e ainda perderia o nome que ele quis.
function cmdDeletePage(name) {
    if (!name) {
        console.error("vtnc: delete needs a page name, e.g. vtnc page dashboard delete");
        process.exit(1);
    }
    const config = readConfig();
    const pages = config.pages ?? {};
    if (!pages[name]) {
        console.error(`vtnc: no such page: ${name}`);
        process.exit(1);
    }
    delete pages[name];
    config.pages = pages;
    writeConfig(config);
    const orphaned = (config.islands ?? []).filter((i) => i.page === name).map((i) => i.name);
    console.log(JSON.stringify({ deleted: name, nowEmpty: orphaned }));
}

function cmdSet(namespace, name, args) {
    if (namespace === "island") {
        cmdSetIsland(name, args);
        return;
    }
    if (namespace === "autohide") {
        cmdSetAutohide(args);
        return;
    }
    if (namespace === "hyprland") {
        cmdSetHyprland(args);
        return;
    }
    if (namespace === "page") {
        cmdSetPage(name, args);
        return;
    }
    console.error(`vtnc: set is not supported on namespace "${namespace}" yet`);
    process.exit(1);
}

const argv = process.argv.slice(2);

if (argv.length === 0) {
    startShell();
    process.exit(0);
}

if (argv[0] === "help" || argv[0] === "--help" || argv[0] === "-h") {
    usage();
    process.exit(0);
}

const [namespace, second, ...rest] = argv;

if (!NAMESPACES.has(namespace)) {
    console.error(`vtnc: unknown namespace "${namespace}"`);
    usage();
    process.exit(1);
}

if (!NAMESPACES_WITH_VERBS.has(namespace)) {
    console.error(`vtnc: "${namespace}" has no verbs yet`);
    process.exit(1);
}

let name = null;
let verb;
let args;

if (VERBS.has(second)) {
    verb = second;
    args = rest;
} else {
    name = second;
    verb = rest[0];
    args = rest.slice(1);
}

if (!VERBS.has(verb)) {
    console.error(`vtnc: unknown verb "${verb}"`);
    usage();
    process.exit(1);
}

// 0.506: the trigger moved to the page (decision 1b.5) and ending moved to
// the island (it unstacks, it doesn't need to name a page) — catch the two
// swapped forms here with a message that says where the verb went, instead
// of letting them fail inside the IPC call with "function not found".
if (namespace === "island" && verb === "call") {
    console.error('vtnc: island declares no trigger — call it from the page instead: vtnc page <name> call <island>');
    process.exit(1);
}
if (namespace === "page" && verb === "end") {
    console.error('vtnc: ending a call is per-island, not per-page: vtnc island <name> end');
    process.exit(1);
}
// `generate` is hyprland-only (0.507) — it's a local write+reload, not an
// IPC verb, so every other namespace rejects it here instead of failing
// inside ipcCall with a confusing "function not found".
if (verb === "generate" && namespace !== "hyprland") {
    console.error(`vtnc: "generate" is only for the hyprland namespace`);
    process.exit(1);
}
// `create`/`delete` so existem no namespace page (0.508) — uma island nao se
// cria nem se apaga pela CLI ainda, e dizer isso aqui e melhor do que deixar
// a chamada morrer dentro do ipcCall.
if ((verb === "create" || verb === "delete") && namespace !== "page") {
    console.error(`vtnc: "${verb}" is only for the page namespace`);
    process.exit(1);
}

switch (verb) {
case "set":
    cmdSet(namespace, name, args);
    break;
case "call":
    console.log(ipcCall(shellRoot, namespace, "call", [name, ...args]));
    break;
case "get":
    console.log(ipcCall(shellRoot, namespace, "get", [name]));
    break;
case "list":
    console.log(ipcCall(shellRoot, namespace, "list", []));
    break;
case "end":
    console.log(ipcCall(shellRoot, namespace, "end", [name, ...args]));
    break;
case "generate":
    cmdGenerateHyprland();
    break;
case "create":
    cmdCreatePage(name);
    break;
case "delete":
    cmdDeletePage(name);
    break;
}
