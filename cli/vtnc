#!/usr/bin/env node
// The CLI (decision 4b.2/4b.3): vtnc <namespace> <name> <verb> <args...>,
// or vtnc <namespace> <verb> <args...> for verbs that don't target one name
// (list). `set` writes config.json directly; `call`/`get`/`list` talk to
// the running shell over IPC (decision 4b.4/4b.5).

import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";
import { execFileSync } from "node:child_process";
import { readConfig, writeConfig } from "./lib/store.js";
import { ipcCall } from "./lib/ipc.js";
import {
    findIsland, validateIslandSet, parseIslandSetValue,
    validateAutohideGlobalSet, parseAutohideGlobalValue, defaultAutohide,
} from "../core/config-shape.mjs";

const VERBS = new Set(["set", "call", "get", "list", "end"]);
// The full namespace list from decision 4b.3 — widget/monitor/preset/theme
// are listed even though they have no verbs yet (also decision 4b.3).
// `autohide` (0.505) is one of the "futuros" 4b.3 already names the list
// as open to — it's global, not per-island, so it has no target name, the
// same grammar `page list`/`service list` already use.
const NAMESPACES = new Set(["island", "page", "widget", "service", "monitor", "preset", "theme", "autohide"]);
const NAMESPACES_WITH_VERBS = new Set(["island", "page", "service", "autohide"]);

// The shell's own source folder — one level up from cli/ — doubles as its
// quickshell config name (vtnc-dev while developing, vtnc once installed),
// so the CLI never has to be told which one it's talking to.
const shellRoot = dirname(dirname(fileURLToPath(import.meta.url)));

function usage() {
    console.log(`usage: vtnc <namespace> <name> <verb> [args...]
       vtnc <namespace> <verb> [args...]   (for verbs with no target name, e.g. list)
       vtnc                                 start the shell
       vtnc help                            this message

namespaces: island, page, widget, service, monitor, preset, theme, autohide
  (widget, monitor, preset and theme have no verbs yet)
verbs: set, call, get, list, end

0.506: the trigger lives on the page, not the island (decision 1b.5) — call
a page onto an island with "page <name> call <island>", never the other
way around. Ending a call is per-island, not per-page — it just pops
whatever's on top ("island <name> end"); it lands back on the idle page by
itself once the stack (up to 5 deep) empties.

island set keys: page, layer, anchor, offset, size, gap, autohide, autohideMode
  (anchor/offset/size take one JSON object argument; gap is one whole number
   of cells — never four sides, it only reserves on the anchored edge;
   autohide is true/false; autohideMode is one of always/window/fullscreen.
   autohide/autohideMode left unset on an island fall back to the global
   autohide values below.)

autohide set keys: enabled, mode, distance
  (global, not per-island: enabled/mode are the fallback for islands that
   don't set their own; distance (cells) is global-only, it also decides
   which of the two hide animations an island gets — see island/README.md)

examples:
  vtnc page launcher call bar       momentary: stacks launcher onto bar
  vtnc island bar end               unstacks one level (back to idle if empty)
  vtnc island bar set page dashboard   permanent: writes config.json
  vtnc island bar set anchor '{"top":true,"left":true}'
  vtnc island bar set offset '{"x":2,"y":0}'
  vtnc island bar set size '{"w":20,"h":6}'
  vtnc island bar set gap 2
  vtnc island bar set autohide true
  vtnc island bar set autohideMode window
  vtnc island bar get               current state, as JSON
  vtnc island list                  all islands, as JSON
  vtnc page list                    all pages, as JSON
  vtnc service list                 which services are on and who's holding them
  vtnc service clock get            one service's state, as JSON
  vtnc autohide set distance 3      global trigger distance, in cells
  vtnc autohide list                current global autohide config, as JSON`);
}

function startShell() {
    execFileSync("qs", ["-p", shellRoot], { stdio: "inherit" });
}

function cmdSetIsland(name, args) {
    const [key, rawValue] = args;
    if (!key || rawValue === undefined) {
        console.error("vtnc: set needs a key and a value, e.g. set page dashboard");
        process.exit(1);
    }

    const config = readConfig();
    const island = findIsland(config, name);
    if (!island) {
        console.error(`vtnc: no such island: ${name}`);
        process.exit(1);
    }

    const value = parseIslandSetValue(key, rawValue);
    const error = validateIslandSet(key, value, config);
    if (error) {
        // config.json is untouched: we haven't written anything yet.
        console.error(`vtnc: ${error}`);
        process.exit(1);
    }

    island[key] = value;
    writeConfig(config);
    console.log(JSON.stringify(island));
}

// `vtnc autohide set <key> <value>` (0.505): global, no island name — the
// same `vtnc <namespace> <verb> <args>` grammar `page list` already uses.
// distance is global-only by decision 12.4; enabled/mode are the fallback
// an island falls back to when it doesn't set its own autohide/
// autohideMode (decision 11.2c).
function cmdSetAutohide(args) {
    const [key, rawValue] = args;
    if (!key || rawValue === undefined) {
        console.error("vtnc: set needs a key and a value, e.g. set distance 2");
        process.exit(1);
    }

    const config = readConfig();
    const value = parseAutohideGlobalValue(key, rawValue);
    const error = validateAutohideGlobalSet(key, value);
    if (error) {
        console.error(`vtnc: ${error}`);
        process.exit(1);
    }

    config.autohide = { ...defaultAutohide(), ...config.autohide, [key]: value };
    writeConfig(config);
    console.log(JSON.stringify(config.autohide));
}

function cmdSet(namespace, name, args) {
    if (namespace === "island") {
        cmdSetIsland(name, args);
        return;
    }
    if (namespace === "autohide") {
        cmdSetAutohide(args);
        return;
    }
    console.error(`vtnc: set is not supported on namespace "${namespace}" yet`);
    process.exit(1);
}

const argv = process.argv.slice(2);

if (argv.length === 0) {
    startShell();
    process.exit(0);
}

if (argv[0] === "help" || argv[0] === "--help" || argv[0] === "-h") {
    usage();
    process.exit(0);
}

const [namespace, second, ...rest] = argv;

if (!NAMESPACES.has(namespace)) {
    console.error(`vtnc: unknown namespace "${namespace}"`);
    usage();
    process.exit(1);
}

if (!NAMESPACES_WITH_VERBS.has(namespace)) {
    console.error(`vtnc: "${namespace}" has no verbs yet`);
    process.exit(1);
}

let name = null;
let verb;
let args;

if (VERBS.has(second)) {
    verb = second;
    args = rest;
} else {
    name = second;
    verb = rest[0];
    args = rest.slice(1);
}

if (!VERBS.has(verb)) {
    console.error(`vtnc: unknown verb "${verb}"`);
    usage();
    process.exit(1);
}

// 0.506: the trigger moved to the page (decision 1b.5) and ending moved to
// the island (it unstacks, it doesn't need to name a page) — catch the two
// swapped forms here with a message that says where the verb went, instead
// of letting them fail inside the IPC call with "function not found".
if (namespace === "island" && verb === "call") {
    console.error('vtnc: island declares no trigger — call it from the page instead: vtnc page <name> call <island>');
    process.exit(1);
}
if (namespace === "page" && verb === "end") {
    console.error('vtnc: ending a call is per-island, not per-page: vtnc island <name> end');
    process.exit(1);
}

switch (verb) {
case "set":
    cmdSet(namespace, name, args);
    break;
case "call":
    console.log(ipcCall(shellRoot, namespace, "call", [name, ...args]));
    break;
case "get":
    console.log(ipcCall(shellRoot, namespace, "get", [name]));
    break;
case "list":
    console.log(ipcCall(shellRoot, namespace, "list", []));
    break;
case "end":
    console.log(ipcCall(shellRoot, namespace, "end", [name, ...args]));
    break;
}
