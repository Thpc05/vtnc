pragma Singleton

import QtQuick
import Quickshell
import "index.js" as Index

// A directory import per app folder, on purpose unused: a URL load alone doesn't tell Quickshell's
// hot reload to watch those files (the trailing comment keeps tools/unused-imports.py from dropping
// them).
import qs.apps.clipboard // hot reload
import qs.apps.dino // hot reload
import qs.apps.helper // hot reload
import qs.apps.launcher // hot reload
import qs.apps.notes // hot reload
import qs.apps.notifications // hot reload
import qs.apps.session // hot reload
import qs.apps.tools // hot reload
import qs.apps.wallpaper // hot reload
import qs.dashboard // hot reload
import qs.settings // hot reload

// The island's apps. Each one is a folder that describes itself in meta.js (title, icon, keepAlive,
// closeOnEsc and, when it has one, its launch target) and draws itself in View.qml; apps/index.js
// collects them (generated by tools/catalog.py). The island loads the view by URL
// ([[isolation by URL]]: a broken app fails on its own).
// To add one: create apps/<id>/ with meta.js and View.qml, run tools/check (it writes index.js), and
// add an AppTarget in shell/Ipc.qml to open it with `qs -c vtnc-dev ipc call <id> open`.
Singleton {
    id: root

    // id → { title, icon, keepAlive, closeOnEsc, launch? }
    readonly property var apps: Index.APPS

    function get(appId: string): var {
        return apps[appId] ?? null;
    }

    function has(appId: string): bool {
        return apps[appId] !== undefined;
    }

    // the app's View.qml ("" when the id is unknown)
    function url(appId: string): url {
        return has(appId) ? Qt.resolvedUrl(Index.FOLDERS[appId] + "/View.qml") : "";
    }
}
